# The Dockerfile only copies requirements.txt and src/.
# This file keeps the build context small and keeps secrets out of it.

# Secrets and local config
.env
.env.*
!.env.example

# Git, CI, local tooling
.git
.github
.claude
.planning
CLAUDE.md
.vscode/
.idea/

# Python
**/__pycache__
**/*.py[cod]
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Not needed in the image
tests/
docs/
scripts/
assets/

# OS cruft
**/.DS_Store
**/Thumbs.db
